<Window x:Class="GoPing.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoPing"
        Width="440"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border CornerRadius="10"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="GoPing" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" Margin="2,0,0,0" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="40,0,40,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="Welcome" FontSize="27" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="A local messenger for you and your friends."
                               FontSize="14" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <Button x:Name="GithubButton" Style="{StaticResource PrimaryButton}"
                            Margin="0,30,0,0" Click="GithubButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                <Path Fill="#FFFFFF"
                                      Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0016 8c0-4.42-3.58-8-8-8z"/>
                            </Viewbox>
                            <TextBlock Text="Continue with GitHub" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Grid Margin="0,22,0,22">
                        <Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="or use a server token"
                                   Background="{StaticResource BgBrush}"
                                   Foreground="{StaticResource FaintBrush}"
                                   FontSize="12" Padding="10,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Server token" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <TextBox x:Name="TokenBox" Style="{StaticResource MonoField}" MaxLength="19"
                                 TextChanged="TokenBox_TextChanged" KeyDown="TokenBox_KeyDown"/>
                        <TextBlock x:Name="TokenPlaceholder" Text="GOPING-XXXXXXXXXXXX"
                                   Foreground="{StaticResource FaintBrush}" FontFamily="Consolas"
                                   FontSize="14" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>
                    <Button x:Name="SignInButton" Style="{StaticResource SecondaryButton}"
                            Content="Sign in with token" Margin="0,12,0,0" Click="SignInButton_Click"/>

                    <TextBlock x:Name="StatusText" MinHeight="20" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="The token is issued by your server admin and stored encrypted on this PC."
                           FontSize="12" Foreground="{StaticResource FaintBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
