<Window x:Class="GoPing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoPing"
        Width="980" Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border x:Name="RootBorder" CornerRadius="10"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="GoPing" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServerLabel" FontSize="12"
                               Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}"
                            Click="MaximizeButton_Click" Content="&#xE922;" ToolTip="Maximize"/>
                    <Button x:Name="ThemeToggleButton" Style="{StaticResource TitleBarButton}"
                            Click="ThemeToggleButton_Click" Content="&#xE708;"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            Click="MinimizeButton_Click" ToolTip="Minimize"/>
                    <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;"
                            Margin="2,0,0,0" Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="SidebarBorder" Background="{DynamicResource SurfaceBrush}">
                    <Grid Margin="20,22,20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Grid Width="64" Height="64" HorizontalAlignment="Left">
                                <Ellipse x:Name="AvatarEllipse" Width="64" Height="64"/>
                                <TextBlock x:Name="AvatarInitial" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="NicknameText" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                       Margin="0,14,0,0"/>
                            <TextBlock x:Name="UsernameText" FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                            <Button x:Name="EditProfileButton" Style="{StaticResource SecondaryButton}"
                                    Content="Edit profile" Margin="0,20,0,0" Click="EditProfileButton_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Local messenger" FontSize="12"
                                   Foreground="{DynamicResource FaintBrush}"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

                <Grid Grid.Column="2">
                    <Grid x:Name="ChatPanel">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                            <Border Width="52" Height="52" CornerRadius="12"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No chats yet" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                       Margin="0,18,0,0"/>
                            <TextBlock Text="Your local messenger is ready. Chats will appear here."
                                       FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ProfilePanel" Background="{DynamicResource BgBrush}" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="460" HorizontalAlignment="Left" Margin="40,34,40,40">
                                <TextBlock Text="Edit profile" FontSize="23" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Changes are saved to your GoPing server."
                                           FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,6,0,0"/>

                                <Grid Margin="0,26,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="64" Height="64">
                                        <Ellipse x:Name="ProfileAvatar" Width="64" Height="64"/>
                                        <TextBlock x:Name="ProfileAvatarInitial" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Button x:Name="UploadAvatarButton" Style="{StaticResource SecondaryButton}"
                                                Content="Upload avatar" HorizontalAlignment="Left"
                                                Click="UploadAvatarButton_Click"/>
                                        <Button x:Name="RemoveAvatarButton" Style="{StaticResource DangerGhostButton}"
                                                Content="Remove avatar" HorizontalAlignment="Left"
                                                Margin="0,4,0,0" Click="RemoveAvatarButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Nickname" Style="{StaticResource FieldLabel}" Margin="0,26,0,6"/>
                                <TextBox x:Name="NicknameBox" Style="{StaticResource Field}" MaxLength="50"/>

                                <TextBlock Text="Username" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                                <TextBox x:Name="UsernameBox" Style="{StaticResource Field}" MaxLength="32"/>
                                <TextBlock Text="3–32 characters: latin letters, digits and _"
                                           FontSize="12" Foreground="{DynamicResource FaintBrush}"
                                           Margin="0,6,0,0"/>

                                <TextBlock Text="Bio" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                                <TextBox x:Name="BioBox" Style="{StaticResource Field}" Height="92"
                                         AcceptsReturn="True" TextWrapping="Wrap" MaxLength="300"
                                         VerticalContentAlignment="Top" Padding="10,9"/>

                                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}"
                                            Content="Save changes" Click="SaveButton_Click"/>
                                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                                            Content="Cancel" Margin="10,0,0,0" Click="CancelButton_Click"/>
                                </StackPanel>
                                <Button x:Name="SignOutButton" Style="{StaticResource GhostButton}"
                                        Content="Sign out" Margin="0,14,0,0" HorizontalAlignment="Left"
                                        Click="SignOutButton_Click"/>
                                <TextBlock x:Name="ProfileStatusText" MinHeight="20" FontSize="13"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>