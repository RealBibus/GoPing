<Window x:Class="GoPing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GoPing"
        Width="980" Height="680"
        MinWidth="860" MinHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
         PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="WindowRoot">
        <Border x:Name="RootBorder" CornerRadius="10"
                Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="GoPing" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button x:Name="ProfileButton" Style="{StaticResource TitleBarButton}"
                            Width="30" Click="EditProfileButton_Click" ToolTip="Profile">
                        <Grid Width="22" Height="22">
                            <Ellipse x:Name="AvatarEllipse" Width="22" Height="22"
                                     Fill="{DynamicResource SurfaceHoverBrush}"/>
                            <TextBlock x:Name="AvatarInitial" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            Click="MinimizeButton_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}"
                            Click="MaximizeButton_Click" Content="&#xE922;" ToolTip="Maximize"/>
                    <Button x:Name="CloseTitleBarButton" Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;"
                            Margin="2,0,0,0" Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid x:Name="MainContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="PeerPanelColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ChatPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ChatListColumn" Width="226" MinWidth="170" MaxWidth="340"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <!-- Список чатов -->
                        <Grid Grid.Column="0" Margin="14,18,14,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ChatsTitle" Text="Chats" FontSize="16"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                <Border Height="34" Margin="0,10,0,0" CornerRadius="8"
                                        Background="{DynamicResource SearchFieldBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{DynamicResource FaintBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Margin="9,0,0,0" IsHitTestVisible="False"/>
                                        <TextBox x:Name="ChatSearchBox" Style="{StaticResource Field}"
                                                 Height="32" Margin="28,0,4,0" Padding="0"
                                                 Background="Transparent" BorderThickness="0"
                                                 FontSize="13" KeyDown="ChatSearchBox_KeyDown"
                                                 TextChanged="ChatSearchBox_TextChanged"
                                                 GotFocus="ChatSearchBox_GotFocus"
                                                 LostFocus="ChatSearchBox_LostFocus"/>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="SearchFilters" Orientation="Horizontal"
                                            Margin="0,8,0,0" Visibility="Collapsed">
                                    <Button x:Name="MyChatsFilterButton" Content="My chats"
                                            Style="{StaticResource FilterButton}" Tag="Selected"
                                            Click="MyChatsFilterButton_Click"/>
                                    <Button x:Name="GlobalFilterButton" Content="Global"
                                            Style="{StaticResource FilterButton}" Margin="6,0,0,0"
                                            Click="GlobalFilterButton_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Избранное: отдельный чат, закреплённый над списком -->
                            <Button x:Name="FavoritesButton" Grid.Row="1" Margin="0,10,0,0"
                                    Height="56" Padding="10,8" ToolTip="Favorites"
                                    HorizontalContentAlignment="Stretch"
                                    Click="FavoritesButton_Click" Visibility="Collapsed">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="FavBd" CornerRadius="8" Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="FavBd" Property="Background"
                                                        Value="{DynamicResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="FavBd" Property="Background"
                                                        Value="{DynamicResource SelectedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="Selected">
                                                <Setter TargetName="FavBd" Property="Background"
                                                        Value="{DynamicResource SelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="40" Height="40" Margin="0,0,10,0">
                                        <Ellipse Width="40" Height="40"
                                                 Fill="{DynamicResource FavoritesBrush}"/>
                                        <Path Data="{StaticResource FavoritesIconGeometry}"
                                              Fill="White" Width="17" Height="17"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Favorites" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock x:Name="FavoritesPreview" Text="No messages yet"
                                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <ListBox x:Name="ChatList" Grid.Row="2" Margin="0,12,0,0"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="ChatList_SelectionChanged">
                                <ListBox.Resources>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,0,3"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" CornerRadius="8"
                                                            Background="Transparent"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{DynamicResource SelectedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <Ellipse x:Name="ItemAvatar" Width="40" Height="40"
                                                         Fill="{DynamicResource SurfaceHoverBrush}"/>
                                                <TextBlock x:Name="InitialText"
                                                           Text="{Binding Title, Converter={StaticResource InitialLetterConverter}}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Path x:Name="FavoritesIcon"
                                                      Data="{StaticResource FavoritesIconGeometry}"
                                                      Fill="White" Width="16" Height="16" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="Collapsed"/>
                                                <Image Width="40" Height="40" Stretch="UniformToFill"
                                                       Loaded="ChatAvatarImage_Loaded">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock FontSize="12"
                                                           Loaded="ChatPreview_Loaded"
                                                           DataContextChanged="ChatPreview_DataContextChanged"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                                <Setter TargetName="ItemAvatar" Property="Fill"
                                                        Value="{DynamicResource FavoritesBrush}"/>
                                                <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="FavoritesIcon" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Глобальный поиск пользователей -->
                            <ListBox x:Name="GlobalSearchResults" Grid.Row="1" Grid.RowSpan="2"
                                     Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="GlobalSearchResults_SelectionChanged"
                                     Visibility="Collapsed">
                                <ListBox.Resources>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,0,3"/>
                                        <Setter Property="Padding" Value="10,7"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ResultBd" CornerRadius="8"
                                                            Background="Transparent"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ResultBd" Property="Background"
                                                                    Value="{DynamicResource HoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ResultBd" Property="Background"
                                                                    Value="{DynamicResource SelectedBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="36" Height="36" Margin="0,0,10,0">
                                                <Ellipse Fill="{DynamicResource SurfaceHoverBrush}"/>
                                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Text="{Binding Username, Converter={StaticResource InitialLetterConverter}}"/>
                                                <Image Width="36" Height="36" Stretch="UniformToFill"
                                                       Source="{Binding AvatarUrl, Converter={StaticResource AvatarImageSourceConverter}}">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="@" FontSize="13"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Text="{Binding Username}" FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Nickname}" FontSize="12"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="3" Height="42"/>
                        </Grid>

                        <!-- Разделитель: тянет границу между списком чатов и перепиской -->
                        <GridSplitter Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Columns"
                                      ShowsPreview="True"
                                      Cursor="SizeWE"
                                      Focusable="False">
                            <GridSplitter.Template>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Border x:Name="SplitterArea" Background="Transparent">
                                        <Rectangle x:Name="SplitterLine" Width="2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Stretch"
                                                   Fill="{DynamicResource SplitterBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SplitterLine" Property="Width" Value="4"/>
                                            <Setter TargetName="SplitterLine" Property="Fill"
                                                    Value="{DynamicResource SplitterHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="SplitterLine" Property="Width" Value="4"/>
                                            <Setter TargetName="SplitterLine" Property="Fill"
                                                    Value="{DynamicResource SplitterHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>

                        <Grid Grid.Column="2">
                            <!-- Заглушка, когда чат не выбран -->
                            <StackPanel x:Name="NoChatSelected" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="30">
                                <Border Width="52" Height="52" CornerRadius="12"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="EmptyStateTitle" Text="No chats yet" FontSize="21"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                           TextAlignment="Center" Margin="0,18,0,0"/>
                                <TextBlock x:Name="EmptyStateText"
                                           Text="Search for a friend in the field above to start a conversation."
                                           FontSize="14" Foreground="{DynamicResource MutedBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="320" Margin="0,8,0,0"/>

                            </StackPanel>

                            <!-- Переписка -->
                            <Grid x:Name="ThreadPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="22,15"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="44" Height="44" VerticalAlignment="Center"
                                              MouseLeftButtonDown="ThreadAvatar_MouseLeftButtonDown">
                                            <Ellipse x:Name="ThreadAvatar" Width="44" Height="44"
                                                     Fill="{DynamicResource SurfaceHoverBrush}"/>
                                            <TextBlock x:Name="ThreadAvatarInitial" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Path x:Name="ThreadFavoritesIcon"
                                                  Data="{StaticResource FavoritesIconGeometry}"
                                                  Fill="White" Width="20" Height="20" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="Collapsed"/>
                                        </Grid>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThreadTitle" FontSize="17" FontWeight="SemiBold"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      TextTrimming="CharacterEllipsis"
                                                      MouseLeftButtonDown="ThreadTitle_MouseLeftButtonDown"/>
                                            <TextBlock x:Name="ChatStatusText"
                                                      Text=""
                                                      FontSize="12" Margin="0,2,0,0"
                                                      Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <Button x:Name="CallButton"
                                                Style="{StaticResource TitleBarButton}"
                                                Content="&#xE717;" ToolTip="Voice call"
                                                Margin="16,0,0,0" VerticalAlignment="Center"
                                                IsEnabled="False" Visibility="Collapsed"
                                                Click="CallButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Закреплённые сообщения: видны и для 'me', и для 'chat' -->
                                <Border x:Name="PinnedBar" Grid.Row="1" Visibility="Collapsed"
                                        Padding="16,7" Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   ToolTip="Pinned messages"/>
                                        <ScrollViewer Grid.Column="1" Margin="10,0,0,0"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="PinnedList">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource GhostButton}"
                                                                Height="26" Padding="8,0" Margin="0,0,6,0"
                                                                MaxWidth="300"
                                                                Click="PinnedItem_Click"
                                                                ToolTip="{Binding Text}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Sender.Nickname}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock Text=":" FontSize="11"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="3,0,0,0"/>
                                                                <TextBlock Text="{Binding Text}" FontSize="11"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="5,0,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <ScrollViewer x:Name="MessagesScroll" Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="22,16">
                                    <StackPanel x:Name="MessagesPanel"/>
                                </ScrollViewer>

                                <Border Grid.Row="3" Padding="16,12"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,0">
                                     <StackPanel>
                                         <Border x:Name="ReplyBanner" Visibility="Collapsed"
                                                 Background="{DynamicResource AccentSoftBrush}"
                                                 BorderBrush="{DynamicResource AccentBrush}"
                                                 BorderThickness="0,0,0,1"
                                                 Padding="10,7" Margin="0,0,0,10" CornerRadius="6,6,0,0">
                                             <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*"/>
                                                     <ColumnDefinition Width="Auto"/>
                                                 </Grid.ColumnDefinitions>
                                                 <StackPanel Margin="0,0,10,0">
                                                     <TextBlock x:Name="ReplySenderText" FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource AccentBrush}"/>
                                                     <TextBlock x:Name="ReplyPreviewText" FontSize="12"
                                                                Foreground="{DynamicResource MutedBrush}"
                                                                TextTrimming="CharacterEllipsis"
                                                                Margin="0,2,0,0"/>
                                                 </StackPanel>
                                                 <Button x:Name="CancelReplyButton" Grid.Column="1"
                                                         Style="{StaticResource GhostButton}"
                                                         Content="Cancel" Padding="8,3" FontSize="11"
                                                         ToolTip="Cancel reply"
                                                         Click="CancelReplyButton_Click"/>
                                             </Grid>
                                         </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="EmojiButton" Width="34" Height="34"
                                                Style="{StaticResource GhostButton}"
                                                Padding="0" Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Emoji" Click="EmojiButton_Click">
                                            <Viewbox Width="18" Height="18">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Canvas.Left="2" Canvas.Top="2"
                                                             Width="20" Height="20" Fill="Transparent"
                                                             Stroke="{DynamicResource MutedBrush}"
                                                             StrokeThickness="1.8"/>
                                                    <Ellipse Canvas.Left="7" Canvas.Top="8.5"
                                                             Width="2" Height="2"
                                                             Fill="{DynamicResource MutedBrush}"/>
                                                    <Ellipse Canvas.Left="15" Canvas.Top="8.5"
                                                             Width="2" Height="2"
                                                             Fill="{DynamicResource MutedBrush}"/>
                                                    <Path Stroke="{DynamicResource MutedBrush}"
                                                          StrokeThickness="1.8" StrokeEndLineCap="Round"
                                                          Data="M7,14 Q12,19 17,14"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                        <TextBox x:Name="MessageBox" Grid.Column="1" Style="{StaticResource Field}"
                                                 MaxLength="4000" KeyDown="MessageBox_KeyDown"
                                                 ToolTip="Enter — send, Shift+Enter — new line"/>
                                        <Border x:Name="VoiceRecordingPanel" Grid.Column="1" Visibility="Collapsed"
                                                CornerRadius="8" Padding="12,6" Background="{DynamicResource SurfaceHoverBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="VoiceRecordingDot" Width="8" Height="8" Fill="#DA373C"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="VoiceRecordingText" Grid.Column="1" Text="0:00" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <!-- Живая полоска частот голоса (полосы строятся в code-behind) -->
                                                <StackPanel x:Name="VoiceWavePanel" Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Height="26" ClipToBounds="True"/>
                                                <TextBlock Grid.Column="3" Text="Release to send" FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="VoiceRecordButton" Grid.Column="2"
                                                Style="{StaticResource GhostButton}"
                                                Width="34" Height="34" Padding="0" Margin="8,0,0,0"
                                                VerticalAlignment="Center" ToolTip="Hold to record a voice message"
                                                PreviewMouseLeftButtonDown="VoiceRecordButton_PreviewDown"
                                                PreviewMouseLeftButtonUp="VoiceRecordButton_PreviewUp">
                                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </Button>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button x:Name="VoiceCancelButton" Visibility="Collapsed"
                                                    Style="{StaticResource GhostButton}"
                                                    Width="34" Height="34" Padding="0"
                                                    VerticalAlignment="Center" ToolTip="Cancel recording"
                                                    Click="VoiceCancelButton_Click">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           Foreground="#DA373C"/>
                                            </Button>
                                            <Button x:Name="VoiceStopButton" Visibility="Collapsed"
                                                    Style="{StaticResource GhostButton}"
                                                    Width="34" Height="34" Padding="0" Margin="4,0,0,0"
                                                    VerticalAlignment="Center" ToolTip="Stop and send"
                                                    Click="VoiceStopButton_Click">
                                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                           Foreground="#23A55A"/>
                                            </Button>
                                        </StackPanel>
                                        <Button x:Name="SendButton" Grid.Column="3"
                                                Style="{StaticResource PrimaryButton}"
                                                Content="Send" Margin="10,0,0,0"
                                                Click="SendButton_Click"/>
                                        <!-- Локальный набор эмодзи из папки emojiP -->
                                        <Popup x:Name="EmojiPickerPopup"
                                               PlacementTarget="{Binding ElementName=EmojiButton}"
                                               Placement="Top" HorizontalOffset="-6" VerticalOffset="-6"
                                               StaysOpen="False" AllowsTransparency="True"
                                               PopupAnimation="Fade" Width="360">
                                            <Border CornerRadius="10" Padding="10"
                                                    Background="{DynamicResource BgBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                                                      Opacity="0.18"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBox x:Name="EmojiSearchBox" Height="30"
                                                             Style="{StaticResource Field}"
                                                             FontSize="12" ToolTip="Search"
                                                             TextChanged="EmojiSearchBox_TextChanged"/>
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                                Margin="0,8,0,0">
                                                        <Button x:Name="PackTabButton" Content="Pack"
                                                                Style="{StaticResource FilterButton}"
                                                                Tag="Selected" Click="EmojiTab_Click"/>
                                                        <Button x:Name="UnicodeTabButton" Content="Unicode"
                                                                Style="{StaticResource FilterButton}"
                                                                Margin="6,0,0,0" Click="EmojiTab_Click"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="EmojiMissingText" Grid.Row="2"
                                                               Margin="0,18,0,0" FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Text="Emoji pack is not installed (emojiP folder is missing)."
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               Visibility="Collapsed"/>
                                                    <ScrollViewer x:Name="EmojiScroller" Grid.Row="2"
                                                                  Height="292" Margin="0,8,0,0"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl x:Name="EmojiGrid">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel ItemWidth="42" ItemHeight="42"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource GhostButton}"
                                                                            Width="36" Height="36" Padding="0"
                                                                            Margin="3" Tag="{Binding Number}"
                                                                            ToolTip="{Binding Token}"
                                                                            Click="EmojiItem_Click">
                                                                        <Image Width="32" Height="32"
                                                                               Stretch="Uniform"
                                                                               Loaded="EmojiImage_Loaded"/>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <Grid x:Name="UnicodeEmojiPanel" Grid.Row="2"
                                                          Visibility="Collapsed">
                                                        <ScrollViewer Height="292" Margin="0,8,0,0"
                                                                      VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl x:Name="UnicodeEmojiGrid">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel ItemWidth="42" ItemHeight="42"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource GhostButton}"
                                                                                Width="36" Height="36" Padding="0"
                                                                                Margin="3" FontSize="22"
                                                                                Content="{Binding Char}"
                                                                                ToolTip="{Binding Name}"
                                                                                Click="UnicodeEmojiItem_Click"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                    <StackPanel x:Name="PackPager" Grid.Row="3"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                Margin="0,8,0,0">
                                                        <Button x:Name="EmojiPrevButton" Content="‹"
                                                                Style="{StaticResource GhostButton}"
                                                                Width="30" Height="26" Padding="0"
                                                                Click="EmojiPrevPage_Click"/>
                                                        <TextBlock x:Name="EmojiPageText" Margin="12,0"
                                                                   VerticalAlignment="Center" FontSize="11"
                                                                   Foreground="{DynamicResource MutedBrush}"/>
                                                        <Button x:Name="EmojiNextButton" Content="›"
                                                                Style="{StaticResource GhostButton}"
                                                                Width="30" Height="26" Padding="0"
                                                                Click="EmojiNextPage_Click"/>
                                                    </StackPanel>
                                                    <ScrollViewer x:Name="UnicodeCategoryBar" Grid.Row="3"
                                                                  Height="34" Margin="0,8,0,0"
                                                                  Visibility="Collapsed"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Disabled">
                                                        <ItemsControl x:Name="UnicodeCategoryList">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource FilterButton}"
                                                                            Content="{Binding Name}"
                                                                            Margin="0,0,6,0"
                                                                            Click="UnicodeCategory_Click"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Popup>
                                     </Grid>
                                     </StackPanel>
                                 </Border>
                            </Grid>
                        </Grid>

                    </Grid>

                    <Grid x:Name="ProfilePanel" Background="{DynamicResource BgBrush}" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="460" HorizontalAlignment="Left" Margin="40,34,40,40">
                                <TextBlock x:Name="ProfileHeadingText" Text="Edit profile" FontSize="23" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="ProfileSubtitleText"
                                           Text="Changes are saved to your GoPing server."
                                           FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,6,0,0"/>

                                <Grid Margin="0,26,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="64" Height="64">
                                        <Ellipse x:Name="ProfileAvatar" Width="64" Height="64"/>
                                        <TextBlock x:Name="ProfileAvatarInitial" FontSize="24" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <Button x:Name="UploadAvatarButton" Style="{StaticResource SecondaryButton}"
                                                Content="Upload avatar" HorizontalAlignment="Left"
                                                Click="UploadAvatarButton_Click"/>
                                        <Button x:Name="RemoveAvatarButton" Style="{StaticResource DangerGhostButton}"
                                                Content="Remove avatar" HorizontalAlignment="Left"
                                                Margin="0,4,0,0" Click="RemoveAvatarButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="PeerNicknameText" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                           Visibility="Collapsed" Margin="0,22,0,0"/>
                                <TextBlock x:Name="PeerUsernameText" FontSize="13"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="PeerBioText" FontSize="14" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}" Visibility="Collapsed"
                                           Margin="0,16,0,0"/>

                                <TextBlock x:Name="NicknameLabel" Text="Nickname" Style="{StaticResource FieldLabel}" Margin="0,26,0,6"/>
                                <TextBox x:Name="NicknameBox" Style="{StaticResource Field}" MaxLength="50"/>

                                <TextBlock x:Name="UsernameLabel" Text="Username" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                                <TextBox x:Name="UsernameBox" Style="{StaticResource Field}" MaxLength="32"/>
                                <TextBlock x:Name="UsernameHintText" Text="3–32 characters: latin letters, digits and _"
                                           FontSize="12" Foreground="{DynamicResource FaintBrush}"
                                           Margin="0,6,0,0"/>

                                <TextBlock x:Name="BioLabel" Text="Bio" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                                <TextBox x:Name="BioBox" Style="{StaticResource Field}" Height="92"
                                         AcceptsReturn="True" TextWrapping="Wrap" MaxLength="300"
                                         VerticalContentAlignment="Top" Padding="10,9"/>

                                <StackPanel x:Name="OwnProfileActions" Orientation="Horizontal" Margin="0,24,0,0">
                                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}"
                                            Content="Save changes" Click="SaveButton_Click"/>
                                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                                            Content="Cancel" Margin="10,0,0,0" Click="CancelButton_Click"/>
                                </StackPanel>

                                <Button x:Name="PeerCloseButton" Style="{StaticResource SecondaryButton}"
                                        Content="Close" Margin="0,22,0,0" Visibility="Collapsed"
                                        Click="PeerCloseButton_Click"/>

                                <Button x:Name="SignOutButton" Style="{StaticResource GhostButton}"
                                        Content="Sign out" Margin="0,14,0,0" HorizontalAlignment="Left"
                                        Click="SignOutButton_Click"/>
                                <TextBlock x:Name="ProfileStatusText" MinHeight="20" FontSize="13"
                                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="SettingsPanel" Background="{DynamicResource BgBrush}" Visibility="Collapsed">
                        <Grid.Resources>
                            <Style TargetType="TabControl">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabControl">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True"
                                                          Margin="0,0,0,12"/>
                                                <Border Grid.Row="1" Background="Transparent"
                                                        BorderThickness="0">
                                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                                      ContentSource="SelectedContent"/>
                                                </Border>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="TabItem">
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="12,7"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Bd" CornerRadius="7" Margin="0,0,8,0"
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="Transparent">
                                                <ContentPresenter ContentSource="Header"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentSoftBrush}"/>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="40,30,40,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="SettingsCloseButton" Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Close" Click="SettingsCloseButton_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel Margin="40,16,40,40" MaxWidth="640" HorizontalAlignment="Left">
                                <Border CornerRadius="12" Padding="20" Margin="0,0,0,16"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Notifications" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <CheckBox x:Name="MessageNotificationsCheckBox"
                                                  Content="Show message notifications"
                                                  Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                  Margin="0,0,0,10" Checked="SettingsToggle_Changed"
                                                  Unchecked="SettingsToggle_Changed"/>
                                        <CheckBox x:Name="RaiseWindowOnCallCheckBox"
                                                  Content="Bring window to front on incoming call"
                                                  Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                  Margin="0,0,0,6" Checked="SettingsToggle_Changed"
                                                  Unchecked="SettingsToggle_Changed"/>
                                        <TextBlock Text="Call notifications are shown inside GoPing, not as Windows system notifications."
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="12" Padding="20" Margin="0,0,0,16"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Screen sharing" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Demo FPS" FontSize="13"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="ScreenShareFpsSlider" Minimum="30" Maximum="60"
                                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                                    ValueChanged="ScreenShareFpsSlider_ValueChanged"/>
                                            <Border Grid.Column="1" CornerRadius="6" Padding="10,4" Margin="12,0,0,0"
                                                    Background="{DynamicResource SurfaceHoverBrush}" VerticalAlignment="Center">
                                                <TextBlock x:Name="ScreenShareFpsValueText" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" Text="30 FPS"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Capture mode" FontSize="13"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="ScreenCaptureModeCombo" Width="260" HorizontalAlignment="Left"
                                                  SelectionChanged="ScreenCaptureModeCombo_Changed">
                                            <ComboBoxItem Content="Auto (WGC, then GDI)" Tag="Auto"/>
                                            <ComboBoxItem Content="WGC only" Tag="Wgc"/>
                                            <ComboBoxItem Content="GDI only" Tag="Gdi"/>
                                        </ComboBox>
                                        <TextBlock Text="WGC gives better performance on supported systems. Auto falls back to GDI when WGC is unavailable."
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="12" Padding="20" Margin="0,0,0,16"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="UpdateVersionText" FontSize="13"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"
                                                   Text="Current version: 1.0.0"/>
                                        <CheckBox x:Name="BetaUpdatesCheckBox" Content="Receive beta updates"
                                                  Foreground="{DynamicResource TextBrush}" FontSize="13"
                                                  Margin="0,0,0,12" Checked="BetaUpdatesCheckBox_Changed"
                                                  Unchecked="BetaUpdatesCheckBox_Changed"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="UpdateCheckButton" Style="{StaticResource SecondaryButton}"
                                                    Content="Check for updates" Click="UpdateCheckButton_Click"/>
                                            <Button x:Name="UpdateInstallButton" Style="{StaticResource PrimaryButton}"
                                                    Content="Install update" Margin="10,0,0,0"
                                                    Visibility="Collapsed" Click="UpdateInstallButton_Click"/>
                                        </StackPanel>
                                        <ProgressBar x:Name="UpdateProgressBar" Height="6" Minimum="0" Maximum="100"
                                                     Visibility="Collapsed" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="UpdateStatusText" FontSize="12"
                                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                                   Text="Updates download automatically when available. Click Install to apply and restart."/>
                                        <TextBlock x:Name="UpdateNotesHeader" Text="Release notes" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                   Margin="0,12,0,6" Visibility="Collapsed"/>
                                        <TextBox x:Name="UpdateNotesBox" Style="{StaticResource Field}"
                                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" FontSize="11"
                                                 MaxHeight="150" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="12" Padding="20"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Opacity="0.75">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="Experimental features" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Nothing here yet. New experimental options will appear in this section."
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Профиль другого пользователя — боковая панель, как в Telegram -->
                    <Border x:Name="PeerPanel" Grid.Column="1" Visibility="Collapsed"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Height="48" Padding="16,0" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="Profile" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="PeerPanelCloseButton" HorizontalAlignment="Right"
                                        Style="{StaticResource TitleBarButton}"
                                        Content="&#xE8BB;" Click="PeerPanelCloseButton_Click"
                                        ToolTip="Close profile"/>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20,22,20,20">
                                <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                    <Ellipse x:Name="PeerPanelAvatar" Width="76" Height="76"
                                             Fill="{DynamicResource SurfaceHoverBrush}"/>
                                    <TextBlock x:Name="PeerPanelAvatarInitial" FontSize="28"
                                               FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="PeerPanelNickname" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,14,0,0"/>
                                <TextBlock x:Name="PeerPanelUsername" FontSize="13"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextAlignment="Center" Margin="0,4,0,0"/>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,0"/>
                                <TextBlock Text="ABOUT" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FaintBrush}" Margin="0,16,0,6"/>
                                <TextBlock x:Name="PeerPanelBio" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Нижняя левая панель быстрых действий -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Bottom" Margin="14,0,0,14" Panel.ZIndex="10">
                        <Button x:Name="UpdateAvailableButton" Style="{StaticResource GhostButton}"
                                Width="30" Height="30" Padding="0" Margin="0,0,4,0"
                                HorizontalContentAlignment="Center"
                                FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Foreground="{DynamicResource AccentBrush}"
                                Content="&#xE896;" Click="UpdateAvailableButton_Click"
                                Visibility="Collapsed" ToolTip="Update available"/>
                        <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}"
                                Width="30" Height="30" Padding="0" Margin="0,0,4,0"
                                HorizontalContentAlignment="Center"
                                FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Content="&#xE713;" Click="SettingsButton_Click"
                                ToolTip="Settings"/>
                        <Button x:Name="ConsoleToggleButton" Style="{StaticResource GhostButton}"
                                Width="30" Height="30" Padding="0" Margin="0,0,4,0"
                                HorizontalContentAlignment="Center"
                                FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Content="&#xE9D9;" Click="ConsoleToggleButton_Click"
                                ToolTip="Console"/>
                        <Button x:Name="ThemeToggleButton" Style="{StaticResource GhostButton}"
                                Width="30" Height="30" Padding="0"
                                HorizontalContentAlignment="Center"
                                FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Click="ThemeToggleButton_Click" ToolTip="Toggle theme">
                            <TextBlock x:Name="ThemeIcon" Text="&#xE708;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Своё окно ошибки соединения внутри приложения -->
                    <Grid x:Name="ConnectionFailureOverlay" Visibility="Collapsed"
                          Panel.ZIndex="100" Background="#99000000">
                        <Border x:Name="ConnectionFailureCard"
                                Width="420" Height="230" MinWidth="320" MinHeight="180"
                                MaxWidth="720" MaxHeight="520"
                                CornerRadius="12" Padding="22"
                                Background="{DynamicResource BgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBlock Text="Connection error" FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="ConnectionFailureCloseButton"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource TitleBarButton}"
                                            Content="&#xE8BB;" ToolTip="Close"
                                            Click="ConnectionFailureCloseButton_Click"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Margin="0,18,0,0"
                                           Text="Could not connect to the server after 5 attempts. Check your connection and try again."
                                           FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Margin="0,12,18,0">
                                    <Button x:Name="ConnectionFailureRetryButton"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Retry" Click="ConnectionFailureRetryButton_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Close"
                                            Margin="10,0,0,0"
                                            Click="ConnectionFailureCloseButton_Click"/>
                                </StackPanel>

                                <Thumb x:Name="ConnectionFailureResizeGrip"
                                       Grid.Row="2" Width="16" Height="16"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,2,2" Cursor="SizeNWSE"
                                       DragDelta="ConnectionFailureResizeGrip_DragDelta">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent">
                                                <Path Data="M 3,13 L 13,3 M 7,13 L 13,7"
                                                      Stroke="{DynamicResource MutedBrush}"
                                                      StrokeThickness="1" SnapsToDevicePixels="True"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Border>
                    </Grid>



                    <!-- Звонок: полноэкранный in-app интерфейс. -->
                    <Grid x:Name="CallOverlay" Visibility="Collapsed"
                          Panel.ZIndex="90" Background="#111214">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <wv2:WebView2 x:Name="CallWebView" Grid.Row="0"
                                      Visibility="Collapsed" Panel.ZIndex="2" DefaultBackgroundColor="#111214"/>
                        <Image x:Name="CallRemoteVideo" Grid.Row="0" Grid.RowSpan="3"
                               Stretch="Uniform" Visibility="Collapsed" Panel.ZIndex="0"/>

                        <!-- Центр: собеседник -->
                        <StackPanel x:Name="CallPeerCenter" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MouseLeftButtonUp="CallPeerCenter_Click" Cursor="Hand" Background="Transparent" ToolTip="Click to adjust volume">
                            <Grid Width="168" Height="168" HorizontalAlignment="Center">
                                <Border x:Name="PeerSpeakingRing"
                                        CornerRadius="84"
                                        BorderThickness="4"
                                        BorderBrush="#23A55A"
                                        Opacity="0"/>
                                <Border Width="140" Height="140"
                                        CornerRadius="70"
                                        Background="#2B2D31"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="56" Foreground="#B5BAC1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="CallPeerName" Margin="0,20,0,0"
                                       FontSize="28" FontWeight="SemiBold"
                                       Foreground="#F2F3F5"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" MaxWidth="520"/>
                            <TextBlock x:Name="CallStatusText" Margin="0,8,0,0"
                                       FontSize="14" Foreground="#B5BAC1"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CallPeerStateText" Margin="0,6,0,0"
                                       FontSize="13" Foreground="#F23F43"
                                       TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Статистика звонка: пинг и джиттер -->
                        <Border x:Name="CallStatsPanel" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,20,20,0" Padding="12,10" CornerRadius="12"
                                Background="#CC1E1F22" BorderBrush="#2E3035" BorderThickness="1"
                                Panel.ZIndex="5" Visibility="Collapsed" MinWidth="220">
                            <StackPanel>
                                <TextBlock Text="Call stats" FontSize="12" FontWeight="SemiBold" Foreground="#F2F3F5"/>
                                <TextBlock x:Name="CallPingText" Margin="0,6,0,0" FontSize="12" Foreground="#B5BAC1" Text="Ping: —"/>
                                <TextBlock x:Name="CallJitterText" FontSize="12" Foreground="#B5BAC1" Text="Jitter: —"/>
                                <TextBlock x:Name="CallPacketLossText" FontSize="12" Foreground="#B5BAC1" Text="Packets lost: —"/>
                                <TextBlock Margin="0,8,0,4" FontSize="11" Foreground="#949BA4" Text="Jitter / RTT (recent)"/>
                                <Border Background="#18191C" CornerRadius="8" Padding="6" MaxHeight="160">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="CallJitterHistoryText" FontFamily="Consolas" FontSize="11"
                                                   Foreground="#B5BAC1" TextWrapping="NoWrap" Text="—"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Регулировка громкости собеседника -->
                        <Popup x:Name="CallPeerVolumePopup"
                               PlacementTarget="{Binding ElementName=CallPeerCenter}"
                               Placement="Bottom"
                               HorizontalOffset="0"
                               VerticalOffset="8"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="#1E1F22" BorderBrush="#3A3C42" BorderThickness="1"
                                    CornerRadius="14" Padding="16" MinWidth="300">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="#B5BAC1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Participant volume" FontSize="13" FontWeight="SemiBold" Foreground="#F2F3F5"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="CallPeerVolumeSlider" Minimum="0" Maximum="400" Value="100"
                                                TickFrequency="25" IsSnapToTickEnabled="False"
                                                ValueChanged="CallPeerVolumeSlider_ValueChanged"/>
                                        <TextBlock x:Name="CallPeerVolumeValueText" Grid.Column="1" Margin="12,0,0,0"
                                                   MinWidth="44" TextAlignment="Right"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#F2F3F5" Text="100%"/>
                                    </Grid>
                                    <TextBlock Text="0% - 400%" Margin="0,8,0,0" FontSize="11" Foreground="#949BA4"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Маленький индикатор себя -->
                        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,28,24" Padding="12,10" CornerRadius="14"
                                Background="#1E1F22" BorderBrush="#2E3035" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="40" Height="40" Margin="0,0,10,0">
                                    <Border x:Name="LocalSpeakingRing"
                                            CornerRadius="20"
                                            BorderThickness="3"
                                            BorderBrush="#23A55A"
                                            Opacity="0"/>
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="#5865F2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CallLocalLabel" Text="You"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#F2F3F5"/>
                                    <TextBlock Text="Microphone" FontSize="11" Foreground="#949BA4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Кнопки -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,28" HorizontalAlignment="Center">
                            <StackPanel x:Name="CallIncomingActions"
                                        Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="CallAcceptButton" Width="64" Height="64" Margin="0,0,18,0"
                                        Background="#23A55A" BorderThickness="0" Cursor="Hand"
                                        Click="CallAcceptButton_Click" ToolTip="Answer">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="32">
                                                <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="24" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="CallRejectButton" Width="64" Height="64"
                                        Background="#DA373C" BorderThickness="0" Cursor="Hand"
                                        Click="CallRejectButton_Click" ToolTip="Decline">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="32">
                                                <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="24" Foreground="White"
                                                           RenderTransformOrigin="0.5,0.5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="135"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="CallActiveActions"
                                        Orientation="Horizontal" HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                <Button x:Name="CallMuteButton" Width="56" Height="56" Margin="0,0,16,0"
                                        Background="#2B2D31" BorderThickness="0" Cursor="Hand"
                                        Content="&#xE720;" ToolTip="Mute"
                                        Click="CallMuteButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="28">
                                                <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="20" Foreground="#F2F3F5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="CallDeafenButton" Width="56" Height="56" Margin="0,0,16,0"
                                        Background="#2B2D31" BorderThickness="0" Cursor="Hand"
                                        Content="&#xE7F6;" ToolTip="Deafen"
                                        Click="CallDeafenButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="28">
                                                <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="20" Foreground="#F2F3F5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="CallShareButton" Width="56" Height="56" Margin="0,0,16,0"
                                        Background="#2B2D31" BorderThickness="0" Cursor="Hand"
                                        Content="&#xEBC6;" ToolTip="Share screen"
                                        Click="CallShareButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="28">
                                                <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="20" Foreground="#F2F3F5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="CallEndButton" Width="64" Height="64"
                                        Background="#DA373C" BorderThickness="0" Cursor="Hand"
                                        Click="CallEndButton_Click" ToolTip="End call">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="32">
                                                <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="24" Foreground="White"
                                                           RenderTransformOrigin="0.5,0.5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="135"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Margin="0,0,0,20"
                                   Text="Short connection drops recover silently."
                                   FontSize="11" Foreground="#949BA4"
                                   TextAlignment="Center"/>

                        <Popup x:Name="CallShareSettingsPopup"
                               PlacementTarget="{Binding ElementName=CallShareButton}"
                               Placement="Top"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="#1E1F22" BorderBrush="#3A3C42" BorderThickness="1"
                                    CornerRadius="14" Padding="16" MinWidth="300">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="Screen share" FontSize="13" FontWeight="SemiBold" Foreground="#F2F3F5"/>
                                    <TextBlock Text="Quality" Margin="0,12,0,6" FontSize="12" Foreground="#B5BAC1"/>
                                    <ComboBox x:Name="CallShareQualityCombo" SelectionChanged="CallShareQualityCombo_Changed">
                                        <ComboBoxItem Content="Standard (960p)" Tag="Standard"/>
                                        <ComboBoxItem Content="High (1280p)" Tag="High"/>
                                        <ComboBoxItem Content="HD (1600p)" Tag="HD"/>
                                        <ComboBoxItem Content="Full HD (1920p)" Tag="FullHD"/>
                                    </ComboBox>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="FPS" FontSize="12" Foreground="#B5BAC1" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CallShareFpsValueText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#F2F3F5" Text="30 FPS"/>
                                    </Grid>
                                    <Slider x:Name="CallShareFpsSlider" Margin="0,6,0,0" Minimum="30" Maximum="60"
                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                            ValueChanged="CallShareFpsSlider_ValueChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                                        <Button x:Name="CallSharePopupStopButton" Content="Stop sharing" Margin="0,0,8,0"
                                                Padding="12,6" Visibility="Collapsed" Click="CallSharePopupStopButton_Click"
                                                Background="#2B2D31" Foreground="#F2F3F5" BorderBrush="#3A3C42"/>
                                        <Button x:Name="CallSharePopupStartButton" Content="Choose screen" Padding="12,6"
                                                Click="CallSharePopupStartButton_Click"
                                                Background="#5865F2" Foreground="White" BorderBrush="#5865F2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                </Grid>
            </Grid>

        <!-- Своё popup-меню сообщений вместо системного ContextMenu -->
        <Popup x:Name="MessageActionsPopup"
               Placement="AbsolutePoint"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Width="240" Height="168"
               SnapsToDevicePixels="True"
               KeyDown="MessageActionsPopup_KeyDown">
            <Popup.Resources>
                <ControlTemplate x:Key="MessageActionTemplate" TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Hover" CornerRadius="8" Background="Transparent" Margin="2,1"/>
                        <Rectangle x:Name="Accent" Width="3" RadiusX="1.5" RadiusY="1.5"
                                   Margin="2,9,0,9" HorizontalAlignment="Left"
                                   Fill="{TemplateBinding BorderBrush}" Opacity="0"/>
                        <Grid Margin="16,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding BorderBrush}"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Background"
                                    Value="{DynamicResource SurfaceHoverBrush}"/>
                            <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background"
                                    Value="{DynamicResource AccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

                <Style x:Key="MessageActionButton" TargetType="Button">
                    <Setter Property="Height" Value="42"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template" Value="{StaticResource MessageActionTemplate}"/>
                </Style>

                <Style x:Key="MessageActionDangerButton" TargetType="Button"
                       BasedOn="{StaticResource MessageActionButton}">
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                </Style>

                <Style x:Key="PopupIconButton" TargetType="Button">
                    <Setter Property="Width" Value="24"/>
                    <Setter Property="Height" Value="24"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background"
                                                Value="{DynamicResource SurfaceHoverBrush}"/>
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Popup.Resources>

            <Border VerticalAlignment="Top" Padding="6"
                    Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="8" Opacity="0.28"
                                      Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="10,7,8,6">
                        <TextBlock x:Name="MessageActionsHeading" Text="MESSAGE ACTIONS"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FaintBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="CloseMessageActionsButton"
                                HorizontalAlignment="Right"
                                Style="{StaticResource PopupIconButton}"
                                Content="&#xE8BB;"
                                Click="CloseMessageActions_Click"
                                ToolTip="Close"/>
                    </Grid>
                    <Rectangle Grid.Row="1" Height="1" Margin="8,0,8,4"
                               Fill="{DynamicResource BorderBrush}"/>

                    <!-- Основные действия -->
                    <StackPanel x:Name="MessageActionsMainPanel" Grid.Row="2">
                        <Button x:Name="MessageReplyButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE8CA;" Content="Reply"
                                Click="MessageActionReply_Click"/>
                        <Button x:Name="MessageEditButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE70F;" Content="Edit"
                                Click="MessageActionEdit_Click"/>
                        <Button x:Name="MessageForwardButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE72A;" Content="Forward"
                                Click="MessageActionForward_Click"/>
                        <Button x:Name="MessagePinButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE718;" Content="Pin"
                                Click="MessageActionPin_Click"/>
                        <Button x:Name="MessageDeleteButton"
                                Style="{StaticResource MessageActionDangerButton}"
                                Foreground="{DynamicResource DangerBrush}"
                                Tag="&#xE74D;" Content="Delete"
                                Click="MessageActionDelete_Click"/>
                    </StackPanel>

                    <!-- Подтверждение удаления: для себя или для всех -->
                    <StackPanel x:Name="MessageActionsDeletePanel" Grid.Row="2"
                                Visibility="Collapsed">
                        <Button x:Name="MessageDeleteForMeButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE74D;" Content="Delete for me"
                                Click="MessageActionDeleteForMe_Click"/>
                        <Button x:Name="MessageDeleteForEveryoneButton"
                                Style="{StaticResource MessageActionDangerButton}"
                                Foreground="{DynamicResource DangerBrush}"
                                Tag="&#xE74D;" Content="Delete for everyone"
                                Click="MessageActionDeleteForEveryone_Click"/>
                        <Button x:Name="MessageDeleteCancelButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE72B;" Content="Back"
                                Click="MessageActionDeleteCancel_Click"/>
                    </StackPanel>

                    <!-- Закрепление: для себя или для себя и собеседника -->
                    <StackPanel x:Name="MessageActionsPinPanel" Grid.Row="2"
                                Visibility="Collapsed">
                        <Button x:Name="MessagePinForMeButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE718;" Content="Pin for me"
                                Click="MessageActionPinForMe_Click"/>
                        <Button x:Name="MessagePinForChatButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE718;" Content="Pin for me and peer"
                                Click="MessageActionPinForChat_Click"/>
                        <Button x:Name="MessageUnpinButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE77A;" Content="Remove pin"
                                Click="MessageActionUnpin_Click"/>
                        <Button x:Name="MessagePinCancelButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE72B;" Content="Back"
                                Click="MessageActionPinCancel_Click"/>
                    </StackPanel>

                    <!-- Пересылка: выбор чата -->
                    <StackPanel x:Name="MessageActionsForwardPanel" Grid.Row="2"
                                Visibility="Collapsed">
                        <TextBlock Text="Select chat" Margin="16,8,16,6" FontSize="11"
                                   Foreground="{DynamicResource FaintBrush}"/>
                        <ListBox x:Name="MessageForwardList" MaxHeight="220" Margin="6,0,6,6"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 SelectionChanged="MessageForwardList_SelectionChanged"/>
                        <Button x:Name="MessageForwardCancelButton"
                                Style="{StaticResource MessageActionButton}"
                                Tag="&#xE72B;" Content="Back"
                                Click="MessageActionForwardCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        </Grid>
    </Border>

        <!-- In-app notifications -->
        <StackPanel x:Name="NotificationHost"
                    Panel.ZIndex="90"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,56,16,0"
                    Width="340"
                    IsHitTestVisible="True"/>

        <!-- Custom permission prompt -->
        <Grid x:Name="PermissionOverlay" Panel.ZIndex="92" Visibility="Collapsed" Background="#80000000">
            <Border Width="420" Padding="24" CornerRadius="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="PermissionTitle" Text="Microphone access"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="PermissionBody"
                               Text="GoPing needs access to your microphone for this call."
                               FontSize="13" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="PermissionDenyButton" Content="Deny"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Click="PermissionDenyButton_Click"/>
                        <Button x:Name="PermissionAllowButton" Content="Allow"
                                Style="{StaticResource PrimaryButton}"
                                Click="PermissionAllowButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Custom screen share picker -->
        <Grid x:Name="ScreenPickerOverlay" Panel.ZIndex="92" Visibility="Collapsed" Background="#80000000">
            <Border Width="640" MaxHeight="520" Padding="24" CornerRadius="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Share your screen" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Choose a screen or window to share in the call."
                                   FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Screens" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,8"/>
                            <ListBox x:Name="ScreenPickerMonitors" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="ScreenPicker_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="8"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock Text="Windows" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FaintBrush}" Margin="0,16,0,8"/>
                            <ListBox x:Name="ScreenPickerWindows" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="ScreenPicker_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="8"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Click="ScreenPickerCancel_Click"/>
                        <Button x:Name="ScreenPickerShareButton" Content="Share" Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="ScreenPickerShare_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- WebView2 для записи голосовых: живой слой окна (не Collapsed), иначе микрофон не стартует -->
        <Border Width="1" Height="1" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                IsHitTestVisible="False" Panel.ZIndex="-100">
            <wv2:WebView2 x:Name="VoiceRecorderWebView" IsHitTestVisible="False" Focusable="False"/>
        </Border>

        <!-- Заливка всего окна цветом новой темы -->
        <Border x:Name="ThemeOverlay" CornerRadius="10"
                IsHitTestVisible="False" Panel.ZIndex="100" Visibility="Collapsed">
            <Border.Background>
                <ImageBrush x:Name="ThemeSnapshotBrush" Stretch="Fill"/>
            </Border.Background>
            <Border.OpacityMask>
                <LinearGradientBrush x:Name="ThemeFillBrush" StartPoint="0,1" EndPoint="1,0">
                    <GradientStop x:Name="ThemeFillStart" Offset="0" Color="White"/>
                    <GradientStop x:Name="ThemeFillEdge" Offset="0" Color="White"/>
                    <GradientStop x:Name="ThemeFillFade" Offset="0.03" Color="Transparent"/>
                    <GradientStop x:Name="ThemeFillEnd" Offset="1" Color="Transparent"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <!-- Внутренняя консоль: действия мессенджера, ошибки, запуск сервера/TURN/Radmin -->
        <Border x:Name="ConsolePanel" Visibility="Collapsed" Panel.ZIndex="200"
                Margin="16" CornerRadius="12" Background="{DynamicResource BgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Messenger console" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="ConsoleHintText" Grid.Row="1" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,12"
                           Text="This console shows what GoPing is doing and all errors. Full log: %LOCALAPPDATA%\GoPing\app-console.log"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Start server + TURN" Style="{StaticResource SecondaryButton}"
                            Click="ConsoleStartServerButton_Click"/>
                    <Button Content="Start TURN" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Click="ConsoleStartTurnButton_Click"/>
                    <Button Content="Start Radmin VPN" Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0" Click="ConsoleStartRadminButton_Click"/>
                </StackPanel>
                <TextBox x:Name="ConsoleOutput" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Padding="10" Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <TextBlock x:Name="ConsoleStatusText" HorizontalAlignment="Left"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               MaxWidth="520"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="ConsoleClearButton_Click"/>
                        <Button Content="Copy" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="ConsoleCopyButton_Click"/>
                        <Button Content="Close" Style="{StaticResource SecondaryButton}"
                                Click="ConsoleCloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
