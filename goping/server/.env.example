# Copy this file to .env and replace JWT_SECRET and ADMIN_SECRET.

HTTP_PORT=8080

# SQLite database file, created automatically.
DATABASE_PATH=./data/goping.db

# JWT_SECRET must be at least 32 characters long.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
JWT_ISSUER=goping
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D

# Admin secret used to issue one-time GOPING-XXXXXXXXXXXX server tokens.
# An empty value disables the admin API entirely.
ADMIN_SECRET=dev-only-admin-secret-change-me

# Message encryption key: GOST R 34.12-2015 Kuznyyechik (CTR) plus HMAC-SHA256.
# 64 hex characters or Base64 of 32 bytes. When empty, the key is derived from
# JWT_SECRET, so changing JWT_SECRET makes old messages unreadable.
# Example: openssl rand -hex 32
MESSAGE_KEY=

# GitHub OAuth App. Without these values only server token login is available.
# Callback URL in GitHub settings: http://localhost:8080/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback
GITHUB_SCOPE=read:user

# Uploads. Multipart requests are limited by MAX_FILE_BYTES.
UPLOAD_DIR=./data/uploads
MAX_AVATAR_BYTES=5242880
MAX_FILE_BYTES=52428800

# Public API address used to build absolute avatar and media URLs.
PUBLIC_BASE_URL=http://localhost:8080

# CORS: * or a comma-separated list of origins.
CORS_ORIGINS=*

# Requests per minute from one IP.
AUTH_RATE_LIMIT=30
AVAILABILITY_RATE_LIMIT=120

# Runtime limits sent to clients. MAX_CALL_MINUTES=0 means unlimited calls.
# These four values can also be changed at runtime through the admin API.
MAX_TEXT_LENGTH=4000
MAX_VOICE_SECONDS=300
MAX_CALL_MINUTES=0

# Number of recent log lines kept in memory for the admin logs API.
LOG_LINES=400

# Apply SQL migrations on startup.
AUTO_MIGRATE=true

# Let chat members delete other people's messages. Enabled by default.
ALLOW_DELETE_OTHERS_MESSAGES=true

# WebRTC coturn settings. Without TURN, calls may fail on some networks.
TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
TURN_USERNAME=goping
TURN_CREDENTIAL=gopingturn
