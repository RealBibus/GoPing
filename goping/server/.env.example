# Скопируйте этот файл в .env и поменяйте JWT_SECRET и ADMIN_SECRET.

HTTP_PORT=8080

# SQLite (файл создаётся автоматически)
DATABASE_PATH=./data/goping.db

# JWT_SECRET должен быть не короче 32 символов.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
JWT_ISSUER=goping
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D

# Секрет администратора. Через него выдаются одноразовые токены GOPING-XXXXXXXXXXXX.
# Пустое значение полностью выключает админ-API.
ADMIN_SECRET=dev-only-admin-secret-change-me

# Ключ шифрования сообщений: ГОСТ Р 34.12-2015 «Кузнечик» (CTR) + HMAC-SHA256.
# 64 hex-символа или Base64 от 32 байт. Пусто — ключ выводится из JWT_SECRET
# (тогда смена JWT_SECRET сделает старые сообщения нечитаемыми).
# Пример генерации: openssl rand -hex 32
MESSAGE_KEY=

# GitHub OAuth App. Без этих значений доступен только вход по серверному токену.
# Callback URL в настройках GitHub: http://localhost:8080/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback
GITHUB_SCOPE=read:user

# Аватарки
UPLOAD_DIR=./data/uploads
MAX_AVATAR_BYTES=5242880
# Лимит multipart-запроса; должен быть больше MAX_AVATAR_BYTES.
MAX_UPLOAD_BYTES=10485760

# Публичный адрес API — из него строятся абсолютные ссылки на аватарки.
PUBLIC_BASE_URL=http://localhost:8080

# CORS: * или список origin через запятую
CORS_ORIGINS=*

# Лимиты запросов в минуту с одного IP
AUTH_RATE_LIMIT=30
AVAILABILITY_RATE_LIMIT=120

# Применять миграции при старте
AUTO_MIGRATE=true
