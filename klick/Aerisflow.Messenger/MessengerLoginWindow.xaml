<Window x:Class="Aerisflow.Messenger.MessengerLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aerisflow.Messenger"
        Title="Klick"
        Width="380"
        Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="KlickAccentBrush" Color="#7C5CFA"/>
        <SolidColorBrush x:Key="KlickTextBrush" Color="#1C1B22"/>
        <SolidColorBrush x:Key="KlickSecondaryBrush" Color="#6F6D7A"/>
        <SolidColorBrush x:Key="KlickPlaceholderBrush" Color="#9B99A6"/>
        <SolidColorBrush x:Key="KlickFieldBrush" Color="#F4F3F9"/>
        <SolidColorBrush x:Key="KlickFieldBorderHoverBrush" Color="#DCD8EA"/>
        <LinearGradientBrush x:Key="KlickLogoBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9D7BFF" Offset="0"/>
            <GradientStop Color="#6C4BF4" Offset="1"/>
        </LinearGradientBrush>
        <DrawingImage x:Key="KlickLogoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M7,3 L17,3 Q21,3 21,7 L21,13 Q21,17 17,17 L11,17 L7,21 L7,17 Q3,17 3,13 L3,7 Q3,3 7,3 Z"/>
                    <GeometryDrawing Brush="#7C5CFA" Geometry="M13,5 L8,11 L11.5,11 L10,15 L15,9 L11.5,9 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style x:Key="KlickInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource KlickTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CaretBrush" Value="{StaticResource KlickAccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#557C5CFA"/>
            <Setter Property="Background" Value="{StaticResource KlickFieldBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="0,2,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Margin="12,6,12,8" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FloatLabel" Grid.Row="0" Grid.RowSpan="2"
                                           Text="{TemplateBinding Tag}" FontSize="12"
                                           Foreground="{StaticResource KlickSecondaryBrush}"
                                           VerticalAlignment="Top" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="LabelShift" Y="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Row="1"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                    <Condition Property="Text" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FloatLabel" Property="Foreground" Value="{StaticResource KlickPlaceholderBrush}"/>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="Y"
                                                             To="18" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="FloatLabel" Storyboard.TargetProperty="FontSize"
                                                             To="15" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="FloatLabel" Storyboard.TargetProperty="FontSize"
                                                             To="12" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource KlickFieldBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource KlickAccentBrush}"/>
                                <Setter TargetName="FloatLabel" Property="Foreground" Value="{StaticResource KlickAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KlickPasswordInput" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource KlickTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CaretBrush" Value="{StaticResource KlickAccentBrush}"/>
            <Setter Property="SelectionBrush" Value="#557C5CFA"/>
            <Setter Property="Background" Value="{StaticResource KlickFieldBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="0,2,0,0"/>
            <Setter Property="PasswordChar" Value="•"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Margin="12,6,12,8" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FloatLabel" Grid.Row="0" Grid.RowSpan="2"
                                           Text="{TemplateBinding Tag}" FontSize="12"
                                           Foreground="{StaticResource KlickSecondaryBrush}"
                                           VerticalAlignment="Top" IsHitTestVisible="False">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="LabelShift" Y="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Row="1"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                    <Condition Binding="{Binding Path=(local:FieldState.HasText), RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="FloatLabel" Property="Foreground" Value="{StaticResource KlickPlaceholderBrush}"/>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="Y"
                                                             To="18" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="FloatLabel" Storyboard.TargetProperty="FontSize"
                                                             To="15" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="LabelShift" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="FloatLabel" Storyboard.TargetProperty="FontSize"
                                                             To="12" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource KlickFieldBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource KlickAccentBrush}"/>
                                <Setter TargetName="FloatLabel" Property="Foreground" Value="{StaticResource KlickAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KlickButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="{StaticResource KlickAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8F73FB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#6A48E8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KlickLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource KlickAccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KlickCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource KlickTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Border x:Name="Box" CornerRadius="5" BorderBrush="#C9C5D8" BorderThickness="1.5"/>
                                <Border x:Name="BoxOn" CornerRadius="5" Opacity="0"
                                        Background="{StaticResource KlickAccentBrush}"/>
                                <Path x:Name="Check" Data="M0,4 L3,7 L9,0" Stroke="#FFFFFF" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stretch="Uniform" Width="10" Height="7" Opacity="0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxOn" Property="Opacity" Value="1"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource KlickAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KlickIconButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource KlickSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1EFF8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E7E4F2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KlickCloseButton" TargetType="Button" BasedOn="{StaticResource KlickIconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5484D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C93A3E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#FFFFFF" BorderBrush="#E7E5F0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleLabel" Text="Klick" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource KlickSecondaryBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Button x:Name="BackButton" Style="{StaticResource KlickIconButton}" Content="&#xE72B;" FontSize="12"
                        HorizontalAlignment="Left" Margin="6,0,0,0" Visibility="Collapsed"
                        Click="BackToSignInButton_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button Style="{StaticResource KlickIconButton}" Content="&#xE921;" Click="MinimizeButton_Click"/>
                    <Button Style="{StaticResource KlickCloseButton}" Content="&#xE8BB;" Margin="2,0,0,0" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel x:Name="LoginPanel" Margin="36,0,36,24" VerticalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0"/>
                    </StackPanel.RenderTransform>
                    <Grid Width="84" Height="84" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Border CornerRadius="26" Background="{StaticResource KlickLogoBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C5CFA" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                        </Border>
                        <Image Source="{StaticResource KlickLogoImage}" Width="46" Height="46"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Sign in to Klick" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource KlickTextBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="Enter your email and password to continue."
                               FontSize="13" Foreground="{StaticResource KlickSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBox x:Name="LoginEmailBox" Style="{StaticResource KlickInput}" Tag="Email"
                             Margin="0,26,0,0" KeyDown="LoginInput_KeyDown"/>
                    <PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource KlickPasswordInput}" Tag="Password"
                                 Margin="0,14,0,0" PasswordChanged="PasswordBox_PasswordChanged" KeyDown="LoginInput_KeyDown"/>
                    <CheckBox x:Name="KeepSignedInBox" Style="{StaticResource KlickCheckBox}" Content="Keep me signed in"
                              IsChecked="True" Margin="0,16,0,0"/>
                    <Button x:Name="SignInButton" Style="{StaticResource KlickButton}" Content="Sign in"
                            Margin="0,22,0,0" Click="SignInButton_Click"/>
                    <TextBlock x:Name="LoginStatusText" FontSize="13" Foreground="{StaticResource KlickSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock Text="New to Klick?" FontSize="13"
                                   Foreground="{StaticResource KlickSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource KlickLinkButton}" Content="Create account"
                                Margin="6,0,0,0" Click="CreateAccountButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="RegisterPanel" Margin="36,0,36,24" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="0"/>
                    </StackPanel.RenderTransform>
                    <Grid Width="84" Height="84" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Border CornerRadius="26" Background="{StaticResource KlickLogoBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#7C5CFA" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                        </Border>
                        <Image Source="{StaticResource KlickLogoImage}" Width="46" Height="46"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Create your account" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource KlickTextBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="Pick a username and set a password to join Klick."
                               FontSize="13" Foreground="{StaticResource KlickSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBox x:Name="RegUsernameBox" Style="{StaticResource KlickInput}" Tag="Username"
                             Margin="0,20,0,0" MaxLength="32" KeyDown="RegisterInput_KeyDown"/>
                    <TextBox x:Name="RegEmailBox" Style="{StaticResource KlickInput}" Tag="Email"
                             Margin="0,10,0,0" KeyDown="RegisterInput_KeyDown"/>
                    <PasswordBox x:Name="RegPasswordBox" Style="{StaticResource KlickPasswordInput}" Tag="Password"
                                 Margin="0,10,0,0" PasswordChanged="PasswordBox_PasswordChanged" KeyDown="RegisterInput_KeyDown"/>
                    <PasswordBox x:Name="RegConfirmPasswordBox" Style="{StaticResource KlickPasswordInput}" Tag="Confirm password"
                                 Margin="0,10,0,0" PasswordChanged="PasswordBox_PasswordChanged" KeyDown="RegisterInput_KeyDown"/>
                    <Button x:Name="RegisterSubmitButton" Style="{StaticResource KlickButton}" Content="Create account"
                            Margin="0,20,0,0" Click="RegisterSubmitButton_Click"/>
                    <TextBlock x:Name="RegisterStatusText" FontSize="13" Foreground="{StaticResource KlickSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock Text="Already have an account?" FontSize="13"
                                   Foreground="{StaticResource KlickSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource KlickLinkButton}" Content="Sign in"
                                Margin="6,0,0,0" Click="BackToSignInButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>