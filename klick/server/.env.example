# Скопируйте этот файл в .env и поменяйте JWT_SECRET.

HTTP_PORT=8080

# SQLite (файл создаётся автоматически)
DATABASE_PATH=./data/messenger.db

# JWT_SECRET должен быть не короче 32 символов.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789abcdef
JWT_ISSUER=aerisflow-messenger
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D

# Аватарки
UPLOAD_DIR=./data/uploads
MAX_AVATAR_BYTES=5242880
# Лимит multipart-запроса; должен быть больше MAX_AVATAR_BYTES.
MAX_UPLOAD_BYTES=10485760

# Публичный адрес API — из него строятся абсолютные ссылки на аватарки.
PUBLIC_BASE_URL=http://localhost:8080

# CORS: * или список origin через запятую
CORS_ORIGINS=*

# Лимиты запросов в минуту с одного IP
AUTH_RATE_LIMIT=30
AVAILABILITY_RATE_LIMIT=120

# Применять миграции при старте
AUTO_MIGRATE=true
